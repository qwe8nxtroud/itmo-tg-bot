# Скопируйте в .env для локального запуска или воспользуйтесь start-скриптом.
# Для облака deploy-скрипт создаёт отдельный .env.cloud.
# Никогда не публикуйте настоящий токен или пароль в Git.

# Токен бота от @BotFather (обязательно).
BOT_TOKEN=
# Локально можно оставить пустым; в облаке прокси обязателен.
# Примеры: http://user:password@proxy.example:3128 или socks5://proxy.example:1080
# Символы @, :, / в логине/пароле кодируйте как %40, %3A, %2F.
TELEGRAM_PROXY_URL=

# Локально: 127.0.0.1 и опубликованный порт. В облаке: db и 5432.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=bot
POSTGRES_USER=bot
# Скрипт сгенерирует пароль, если поле пустое. После создания БД не меняйте его
# только в env-файле: пароль роли PostgreSQL хранится внутри самой БД.
POSTGRES_PASSWORD=

LOG_LEVEL=INFO
# Служебный HTTP-порт на 127.0.0.1; наружу в облаке не публикуется.
HEALTH_PORT=8080

# Языковая модель: OpenAI-совместимый API (эндпоинт POST {LLM_API_BASE_URL}/chat/completions).
# Примеры адреса: https://llm.api.cloud.yandex.net/v1 (Yandex AI Studio), https://api.openai.com/v1,
# https://openrouter.ai/api/v1, http://127.0.0.1:11434/v1 (Ollama).
LLM_API_BASE_URL=
# Ключ доступа выбранного провайдера (обязательно; для локальной модели без авторизации — любое непустое значение).
LLM_API_KEY=
# Имя модели у провайдера, например gpt://<folder_id>/yandexgpt/latest или gpt-4o-mini.
# Модель должна поддерживать system-инструкции и temperature.
LLM_MODEL=
# Yandex AI Studio: идентификатор каталога (folder_id), передаётся заголовком OpenAI-Project.
# Для других провайдеров оставьте пустым.
LLM_API_PROJECT=
# Прокси только для вызовов модели (необязательно), формат как у TELEGRAM_PROXY_URL.
LLM_PROXY_URL=
# Таймаут одного обращения к модели, секунд.
LLM_TIMEOUT_SECONDS=60
# Ограничение длины ответа модели в токенах; 0 — не передавать параметр.
LLM_MAX_TOKENS=1024

# Ограничения истории диалога, передаваемой модели вместе с системной инструкцией:
# по числу сообщений (реплики пользователя и ассистента) и по оценочному объёму в символах.
HISTORY_MAX_MESSAGES=20
HISTORY_MAX_CHARS=12000
